      // =========================================================================
      // PERSISTENCE HELPERS (localStorage)
      // =========================================================================
      function normalizeProfile(p, idx) {
        const defaultStyle = AVATAR_STYLES[idx % AVATAR_STYLES.length];
        const validColor = p.color && p.color.includes('border-') ? p.color : defaultStyle;
        return {
          id: p.id || generateId(),
          name: p.name || 'User',
          color: validColor,
          createdAt: p.createdAt || Date.now(),
          mode: ['normal', 'tharki', 'friend'].includes(p.mode) ? p.mode : 'normal',
          tharkiConsent: Boolean(p.tharkiConsent),
          tharkiPersona: ['auto', 'girl', 'guy'].includes(p.tharkiPersona) ? p.tharkiPersona : 'auto',
          friendCharacter: p.friendCharacter || null, // { name, age, gender, behavior }
          friendSetupStep: typeof p.friendSetupStep === 'number' ? p.friendSetupStep : 0, // 0=none, 1=age, 2=gender, 3=behavior
          friendDraft: p.friendDraft || {},
          messages: Array.isArray(p.messages) ? p.messages : [],
        };
      }

      function loadState() {
        try {
          // Support migrating from v1 if present
          const raw = localStorage.getItem(STORAGE_KEY) || localStorage.getItem('chad_ai_app_state_v1');
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed && Array.isArray(parsed.profiles)) {
              appState = {
                profiles: parsed.profiles.map((p, i) => normalizeProfile(p, i)),
                activeProfileId: parsed.activeProfileId || (parsed.profiles[0]?.id ?? null),
                autoChatEnabled: typeof parsed.autoChatEnabled === 'boolean' ? parsed.autoChatEnabled : true,
                lastClosedAt: parsed.lastClosedAt || null,
              };
            }
          }
        } catch (err) {
          console.warn('Could not read localStorage:', err);
        }
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
        } catch (err) {
          console.warn('Could not save to localStorage:', err);
        }
      }

      function getActiveProfile() {
        return appState.profiles.find((p) => p.id === appState.activeProfileId) || null;
      }

      function getSecondaryProfile() {
        return appState.profiles.find((p) => p.id !== appState.activeProfileId) || null;
      }

      // =========================================================================
      // UTILITY FUNCTIONS
      // =========================================================================
      function generateId() {
        return 'prof_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 6);
      }

      function formatTime(timestamp) {
        const d = new Date(timestamp);
        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }

      function formatDateLabel(timestamp) {
        const d = new Date(timestamp);
        const today = new Date();
        if (d.toDateString() === today.toDateString()) {
          return 'Today, ' + formatTime(timestamp);
        }
        return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' • ' + formatTime(timestamp);
      }

      function formatDurationAway(ms) {
        const seconds = Math.floor(ms / 1000);
        if (seconds < 60) return `${seconds} seconds`;
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'}`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'}`;
        const days = Math.floor(hours / 24);
        return `${days} day${days === 1 ? '' : 's'}`;
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      // Format lightweight markdown-like code blocks & bold text safely
      function formatMessageText(rawText) {
        let escaped = escapeHtml(rawText);

        // Format triple-backtick code blocks ```...```
        escaped = escaped.replace(/```([\s\S]*?)```/g, function (_, code) {
          return `<pre class="chat-code">${code.trim()}</pre>`;
        });

        // Format inline backticks `...`
        escaped = escaped.replace(/`([^`]+)`/g, '<code class="bg-zinc-950 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded text-xs font-mono">$1</code>');

        // Format bold **...**
        escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-white">$1</strong>');

        // Format italics *...*
        escaped = escaped.replace(/\*([^*]+)\*/g, '<em class="italic text-zinc-300">$1</em>');

        // Convert newlines outside <pre> into <br>
        const parts = escaped.split(/(<pre class="chat-code">[\s\S]*?<\/pre>)/g);
        return parts
          .map((part) => (part.startsWith('<pre') ? part : part.replace(/\n/g, '<br>')))
          .join('');
      }

      // =========================================================================
      // PROFILE CREATION, SWITCHING & RENAMING
      // =========================================================================
      function createProfile(name) {
        const cleanName = name.trim();
        if (!cleanName) return null;
        if (appState.profiles.length >= MAX_PROFILES) return null;

        const colorIndex = appState.profiles.length % AVATAR_STYLES.length;
        const newProfile = normalizeProfile(
          {
            id: generateId(),
            name: cleanName,
            color: AVATAR_STYLES[colorIndex],
            createdAt: Date.now(),
            mode: 'normal',
            tharkiConsent: false,
            tharkiPersona: 'auto',
            friendCharacter: null,
            friendSetupStep: 0,
            messages: [
              {
                id: 'msg_' + Date.now(),
                sender: 'chad',
                mode: 'normal',
                text: `Hey ${cleanName}. I'm Chad—your personal AI workspace. Ask anything in **@normal**, switch to **@tharki** for charismatic rizz, or build your custom bestie with **@friend**.`,
                timestamp: Date.now(),
              },
