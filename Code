<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chad.ai — Personal AI Assistant</title>
  <!-- Tailwind CSS via CDN for clean, responsive minimalist styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans, Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'SFMono-Regular', 'monospace'],
          },
        },
      },
    };
  </script>

  <style>
    /* Editorial Obsidian Dark Theme & Custom Scrollbars */
    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #09090b;
      color: #f4f4f5;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Subtle dark scrollbars */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f3f46;
    }

    /* Message fade-in animation */
    @keyframes messageSlideIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .msg-animate {
      animation: messageSlideIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Typing dots bounce */
    @keyframes typingDot {
      0%, 80%, 100% {
        transform: scale(0.65);
        opacity: 0.35;
      }
      40% {
        transform: scale(1);
        opacity: 1;
      }
    }

    .typing-dot:nth-child(1) {
      animation: typingDot 1.3s infinite ease-in-out 0s;
    }
    .typing-dot:nth-child(2) {
      animation: typingDot 1.3s infinite ease-in-out 0.18s;
    }
    .typing-dot:nth-child(3) {
      animation: typingDot 1.3s infinite ease-in-out 0.36s;
    }

    /* Editorial code formatting inside messages */
    .chat-code {
      background-color: #0c0c0e;
      color: #e4e4e7;
      border: 1px solid #27272a;
      padding: 0.85rem 1rem;
      border-radius: 0.75rem;
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      font-size: 0.8rem;
      line-height: 1.55;
      overflow-x: auto;
      margin-top: 0.6rem;
      margin-bottom: 0.6rem;
      white-space: pre-wrap;
    }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col bg-zinc-950 text-zinc-100 select-none sm:select-auto">

  <!-- ===================================================================== -->
  <!-- 1. ONBOARDING MODAL (Shown on first visit when no profile exists)     -->
  <!-- ===================================================================== -->
  <div id="onboarding-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-md p-4">
    <div class="w-full max-w-md rounded-2xl bg-zinc-900/95 p-7 sm:p-8 shadow-2xl border border-zinc-800 msg-animate">
      <div class="flex items-center gap-3.5 mb-6">
        <div class="h-11 w-11 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center font-mono font-bold text-lg tracking-tighter shadow-sm">
          C.
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-zinc-100">Chad.ai</h1>
          <p class="text-xs font-mono text-zinc-400">LOCAL PERSONAL AI • NO SIGN-UP</p>
        </div>
      </div>

      <p class="text-sm text-zinc-400 mb-6 leading-relaxed">
        Welcome. Before we begin, what should I call you? Your workspace, personas, and conversation logs stay stored privately on this device.
      </p>

      <form id="onboarding-form" class="space-y-4">
        <div>
          <label for="onboarding-name-input" class="block text-[11px] font-mono uppercase tracking-widest text-zinc-400 mb-2">
            What's your name?
          </label>
          <input
            id="onboarding-name-input"
            type="text"
            maxlength="24"
            placeholder="e.g., Aditya"
            required
            autocomplete="off"
            class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-zinc-100 placeholder-zinc-600 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500 transition"
          />
          <p id="onboarding-error" class="hidden text-xs text-rose-400 mt-1.5">Please enter a valid name.</p>
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-zinc-100 px-4 py-3 text-sm font-semibold text-zinc-950 hover:bg-white active:scale-[0.99] transition cursor-pointer"
        >
          Enter Workspace
        </button>
      </form>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 2. PROFILE ACTION MODAL (Edit Name OR Add Second Profile)             -->
  <!-- ===================================================================== -->
  <div id="profile-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-md p-4">
    <div class="w-full max-w-sm rounded-2xl bg-zinc-900 p-6 shadow-2xl border border-zinc-800 msg-animate">
      <div class="flex items-center justify-between mb-5">
        <h2 id="profile-modal-title" class="text-base font-semibold tracking-tight text-zinc-100">Edit Name</h2>
        <button id="profile-modal-close" type="button" class="rounded-lg p-1.5 text-zinc-500 hover:bg-zinc-800 hover:text-zinc-200 transition cursor-pointer" aria-label="Close modal">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="profile-modal-form" class="space-y-4">
        <div>
          <label for="profile-modal-input" id="profile-modal-label" class="block text-[11px] font-mono uppercase tracking-widest text-zinc-400 mb-2">
            Profile Name
          </label>
          <input
            id="profile-modal-input"
            type="text"
            maxlength="24"
            placeholder="Enter name..."
            required
            autocomplete="off"
            class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-600 focus:border-zinc-500 focus:outline-none transition"
          />
          <p id="profile-modal-error" class="hidden text-xs text-rose-400 mt-1.5"></p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
          <button
            type="button"
            id="profile-modal-cancel"
            class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 transition cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="profile-modal-submit"
            class="rounded-xl bg-zinc-100 px-4 py-2 text-xs font-semibold text-zinc-950 hover:bg-white transition cursor-pointer"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 3. CONFIRMATION MODAL (Replaces browser confirm() for Clear History)  -->
  <!-- ===================================================================== -->
  <div id="confirm-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-md p-4">
    <div class="w-full max-w-sm rounded-2xl bg-zinc-900 p-6 shadow-2xl border border-zinc-800 msg-animate">
      <h2 class="text-base font-semibold text-zinc-100 mb-2">Clear Chat History?</h2>
      <p id="confirm-modal-text" class="text-sm text-zinc-400 mb-6 leading-relaxed">
        This will permanently delete all messages for this profile.
      </p>
      <div class="flex items-center justify-end gap-2">
        <button
          type="button"
          id="confirm-modal-cancel"
          class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 transition cursor-pointer"
        >
          Keep Chat
        </button>
        <button
          type="button"
          id="confirm-modal-ok"
          class="rounded-xl bg-rose-500/90 px-4 py-2 text-xs font-semibold text-white hover:bg-rose-500 transition cursor-pointer"
        >
          Clear History
        </button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 3A. 18+ AGE VERIFICATION & BOUNDARIES MODAL FOR @THARKI MODE          -->
  <!-- ===================================================================== -->
  <div id="tharki-gate-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4">
    <div class="w-full max-w-md rounded-2xl bg-zinc-900 p-6 sm:p-7 shadow-2xl border border-rose-500/25 msg-animate">
      <div class="flex items-center gap-3.5 mb-4">
        <div class="h-10 w-10 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-400 flex items-center justify-center font-mono font-bold text-sm">
          18+
        </div>
        <div>
          <h2 class="text-base font-semibold text-zinc-100">Age Verification Required</h2>
          <p class="text-xs font-mono text-rose-400">@tharki • Flirt & Rizz Persona</p>
        </div>
      </div>

      <p class="text-sm text-zinc-400 leading-relaxed mb-4">
        Unlocking <strong class="text-zinc-200 font-medium">@tharki</strong> shifts Chad into bold, charismatic, and teasing romantic banter tailored to your preference.
      </p>

      <div class="rounded-xl bg-zinc-950/90 border border-rose-500/20 p-3.5 text-xs text-rose-200/90 leading-relaxed mb-6 font-mono">
        [Boundaries: Playful flirting, romantic banter, and spicy PG-13 rizz only — strictly no explicit sexual content, graphic roleplay, or profanity.]
      </div>

      <div class="flex items-center justify-end gap-2.5">
        <button
          type="button"
          id="tharki-gate-cancel"
          class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-xs font-medium text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 transition cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="tharki-gate-agree"
          class="rounded-xl bg-rose-500/90 px-4 py-2.5 text-xs font-semibold text-white hover:bg-rose-500 transition cursor-pointer"
        >
          I am 18+ & Agree
        </button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 3B. @FRIEND CHARACTER BUILDER MODAL (Per-Profile Custom Friend Setup) -->
  <!-- ===================================================================== -->
  <div id="friend-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4">
    <div class="w-full max-w-md rounded-2xl bg-zinc-900 p-6 sm:p-7 shadow-2xl border border-zinc-800 msg-animate">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center font-mono font-bold text-sm">
            @F
          </div>
          <div>
            <h2 class="text-base font-semibold text-zinc-100">Configure @friend</h2>
            <p class="text-xs text-zinc-400">Define age, gender & behavioral traits</p>
          </div>
        </div>
        <button id="friend-modal-close" type="button" class="rounded-lg p-1.5 text-zinc-500 hover:bg-zinc-800 hover:text-zinc-200 transition cursor-pointer" aria-label="Close friend builder">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="friend-modal-form" class="space-y-4 mt-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="friend-name-input" class="block text-[11px] font-mono uppercase tracking-wider text-zinc-400 mb-1.5">
              Alias / Name
            </label>
            <input
              id="friend-name-input"
              type="text"
              maxlength="20"
              placeholder="e.g., Kabir / Maya"
              class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3.5 py-2 text-sm text-zinc-100 placeholder-zinc-600 focus:border-amber-500/50 focus:outline-none transition"
            />
          </div>
          <div>
            <label for="friend-age-input" class="block text-[11px] font-mono uppercase tracking-wider text-zinc-400 mb-1.5">
              Age *
            </label>
            <input
              id="friend-age-input"
              type="number"
              min="13"
              max="99"
              required
              placeholder="e.g., 21"
              class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3.5 py-2 text-sm text-zinc-100 placeholder-zinc-600 focus:border-amber-500/50 focus:outline-none transition"
            />
          </div>
        </div>

        <div>
          <label for="friend-gender-input" class="block text-[11px] font-mono uppercase tracking-wider text-zinc-400 mb-1.5">
            Gender *
          </label>
          <div class="flex gap-2 mb-2" id="friend-gender-presets">
            <button type="button" data-gender="Male" class="gender-chip flex-1 rounded-xl border border-zinc-800 bg-zinc-950 py-1.5 text-xs font-medium text-zinc-300 hover:border-zinc-600 hover:bg-zinc-800/70 transition cursor-pointer">Male</button>
            <button type="button" data-gender="Female" class="gender-chip flex-1 rounded-xl border border-zinc-800 bg-zinc-950 py-1.5 text-xs font-medium text-zinc-300 hover:border-zinc-600 hover:bg-zinc-800/70 transition cursor-pointer">Female</button>
            <button type="button" data-gender="Non-binary" class="gender-chip flex-1 rounded-xl border border-zinc-800 bg-zinc-950 py-1.5 text-xs font-medium text-zinc-300 hover:border-zinc-600 hover:bg-zinc-800/70 transition cursor-pointer">Non-binary</button>
          </div>
          <input
            id="friend-gender-input"
            type="text"
            maxlength="24"
            required
            placeholder="Or specify custom gender..."
            class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3.5 py-2 text-sm text-zinc-100 placeholder-zinc-600 focus:border-amber-500/50 focus:outline-none transition"
          />
        </div>

        <div>
          <label for="friend-behavior-input" class="block text-[11px] font-mono uppercase tracking-wider text-zinc-400 mb-1.5">
            Behavior & Vibe *
          </label>
          <div class="flex flex-wrap gap-1.5 mb-2" id="friend-behavior-presets">
            <button type="button" data-behavior="Chaotic, funny & memes 24/7" class="behavior-chip rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-1 text-[11px] font-medium text-zinc-400 hover:border-amber-500/40 hover:text-amber-300 transition cursor-pointer">Chaotic & Funny</button>
            <button type="button" data-behavior="Chill, loyal & super supportive" class="behavior-chip rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-1 text-[11px] font-medium text-zinc-400 hover:border-amber-500/40 hover:text-amber-300 transition cursor-pointer">Chill & Supportive</button>
            <button type="button" data-behavior="Savage roaster who teases mercilessly" class="behavior-chip rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-1 text-[11px] font-medium text-zinc-400 hover:border-amber-500/40 hover:text-amber-300 transition cursor-pointer">Savage Roaster</button>
            <button type="button" data-behavior="Hype gym bro & high-energy motivator" class="behavior-chip rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-1 text-[11px] font-medium text-zinc-400 hover:border-amber-500/40 hover:text-amber-300 transition cursor-pointer">Hype Gym Bro</button>
          </div>
          <input
            id="friend-behavior-input"
            type="text"
            maxlength="80"
            required
            placeholder="e.g., Dry humor, street-smart, loyal..."
            class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3.5 py-2 text-sm text-zinc-100 placeholder-zinc-600 focus:border-amber-500/50 focus:outline-none transition"
          />
          <p id="friend-modal-error" class="hidden text-xs text-rose-400 mt-1"></p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            id="friend-modal-cancel"
            class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 transition cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="rounded-xl bg-amber-500 px-4 py-2 text-xs font-semibold text-zinc-950 hover:bg-amber-400 transition cursor-pointer"
          >
            Save Character
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 4. TOP NAVIGATION HEADER                                              -->
  <!-- ===================================================================== -->
  <header class="h-14 shrink-0 bg-zinc-950/90 backdrop-blur-md border-b border-zinc-800/80 px-4 sm:px-6 flex items-center justify-between z-30">
    <!-- Left: History Drawer Toggle + Brand Logo -->
    <div class="flex items-center gap-3">
      <button
        id="toggle-history-btn"
        type="button"
        title="View Chat History"
        class="p-2 rounded-xl border border-transparent text-zinc-400 hover:border-zinc-800 hover:bg-zinc-900 hover:text-zinc-100 transition cursor-pointer flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="hidden md:inline text-xs font-medium">History</span>
      </button>

      <div class="h-4 w-[1px] bg-zinc-800 hidden sm:block"></div>

      <div class="flex items-center gap-2.5">
        <div id="brand-logo-box" class="h-8 w-8 rounded-lg bg-zinc-100 text-zinc-950 flex items-center justify-center font-mono font-bold text-sm tracking-tighter transition-colors">
          C.
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-semibold text-sm sm:text-base tracking-tight text-zinc-100">Chad.ai</span>
            <span id="active-mode-badge" class="inline-flex items-center rounded-md bg-zinc-900 px-2 py-0.5 font-mono text-[10px] font-medium text-zinc-300 border border-zinc-800">
              @normal
            </span>
          </div>
          <p id="header-subtitle" class="text-[11px] text-zinc-500 hidden sm:block">Personal AI • Type @tharki or @friend to switch</p>
        </div>
      </div>
    </div>

    <!-- Right: Auto-Chat Status Pill + Profile Switcher Pill -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Auto-Chat / Self-Talk Toggle -->
      <button
        id="autochat-toggle-btn"
        type="button"
        title="Chad talks to himself when idle or while the app is closed"
        class="flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900/80 px-3 py-1.5 text-[11px] font-medium text-zinc-400 hover:border-zinc-700 hover:text-zinc-200 transition cursor-pointer"
      >
        <span id="autochat-dot" class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="hidden sm:inline">Self-Chat</span>
        <span id="autochat-status-text" class="font-mono text-[10px] font-semibold text-zinc-200">ON</span>
      </button>

      <!-- Top-Right Profile Button & Dropdown -->
      <div class="relative" id="profile-menu-container">
        <button
          id="profile-pill-btn"
          type="button"
          class="flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/90 pl-1.5 pr-3 py-1 hover:border-zinc-700 hover:bg-zinc-900 transition cursor-pointer"
        >
          <div id="header-avatar" class="h-6 w-6 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 flex items-center justify-center text-[11px] font-mono font-bold uppercase">
            A
          </div>
          <span id="header-profile-name" class="text-xs font-medium text-zinc-200 max-w-[100px] sm:max-w-[140px] truncate">
            Guest
          </span>
          <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="profile-dropdown"
          class="hidden absolute right-0 mt-2 w-64 rounded-2xl bg-zinc-900/95 backdrop-blur-xl shadow-2xl border border-zinc-800 py-2 z-40 msg-animate"
        >
          <!-- Active Profile Header -->
          <div class="px-4 py-2.5 border-b border-zinc-800/80">
            <p class="text-[10px] font-mono uppercase tracking-widest text-zinc-500">Active Profile</p>
            <p id="dropdown-active-name" class="text-sm font-semibold text-zinc-100 truncate mt-0.5">Guest</p>
            <p id="dropdown-msg-count" class="text-[11px] font-mono text-zinc-500 mt-0.5">0 messages saved</p>
          </div>

          <!-- Profile Actions -->
          <div class="py-1.5 px-2 space-y-0.5">
            <button
              id="menu-edit-name-btn"
              type="button"
              class="w-full flex items-center gap-2.5 rounded-xl px-3 py-2 text-left text-xs font-medium text-zinc-300 hover:bg-zinc-800/80 hover:text-white transition cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              Edit Current Name
            </button>

            <!-- Switch Profile Section (Visible when 2 profiles exist) -->
            <div id="switch-profile-section" class="hidden pt-1 mt-1 border-t border-zinc-800/80">
              <p class="px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-zinc-500">Switch Profile</p>
              <button
                id="menu-switch-profile-btn"
                type="button"
                class="w-full flex items-center justify-between rounded-xl px-3 py-2 text-left text-xs font-medium text-zinc-300 hover:bg-zinc-800/80 hover:text-white transition cursor-pointer"
              >
                <span class="flex items-center gap-2.5 truncate">
                  <span id="switch-profile-avatar" class="h-5 w-5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 flex items-center justify-center text-[10px] font-mono font-bold uppercase shrink-0">
                    B
                  </span>
                  <span id="switch-profile-name" class="truncate">Second Profile</span>
                </span>
