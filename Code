        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        const recentHistory = profile.messages.slice(-8).map((m) => ({
          role: m.sender === 'user' ? 'user' : 'model',
          parts: [{ text: m.text }],
        }));

        const payload = {
          contents: [
            ...recentHistory,
            { role: 'user', parts: [{ text: userMessage }] },
          ],
          systemInstruction: {
            parts: [{ text: buildSystemPromptForMode(profile) }],
          },
        };

        const delays = [1000, 2000];
        for (let attempt = 0; attempt <= delays.length; attempt++) {
          try {
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            const result = await response.json();
            const replyText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
            if (replyText && replyText.trim()) {
              return replyText.trim();
            }
            throw new Error('Empty candidate response');
          } catch (err) {
            if (attempt < delays.length) {
              await new Promise((res) => setTimeout(res, delays[attempt]));
            } else {
              // Seamless offline fallback so Notepad / local file execution works 100%
