      async function handleSendMessage(text) {
        const cleanText = text.trim();
        const active = getActiveProfile();
        if (!cleanText || !active || isGenerating) return;

        // Clear input, hide autocomplete & reset height
        chatInput.value = '';
        chatInput.style.height = 'auto';
        commandAutocomplete.classList.add('hidden');
        resetIdleTimer();

        const lowerCmd = cleanText.toLowerCase();

        // Check for @mode switch commands!
        if (lowerCmd === '@normal' || lowerCmd.startsWith('@normal ')) {
          addMessageToActiveProfile('user', cleanText, Date.now());
          switchMode('normal');
          const remainder = cleanText.slice(7).trim();
          if (remainder) await generateAndAppendReply(remainder, active);
          return;
        }

        if (lowerCmd === '@tharki' || lowerCmd.startsWith('@tharki ')) {
          addMessageToActiveProfile('user', cleanText, Date.now());
          const remainder = cleanText.slice(7).trim();
          if (!active.tharkiConsent) {
            switchMode('tharki', false, remainder || null);
            return;
          }
          switchMode('tharki');
          if (remainder) {
            detectAndUpdateTharkiGender(remainder, active);
            await generateAndAppendReply(remainder, active);
          }
          return;
        }

        if (lowerCmd === '@friend reset' || lowerCmd === '@friend edit') {
          addMessageToActiveProfile('user', cleanText, Date.now());
          switchMode('friend', true);
          return;
        }

        if (lowerCmd === '@friend' || lowerCmd.startsWith('@friend ')) {
          addMessageToActiveProfile('user', cleanText, Date.now());
          switchMode('friend', false);
          const remainder = cleanText.slice(7).trim();
          if (remainder && active.friendCharacter) {
            await generateAndAppendReply(remainder, active);
          }
          return;
        }

        // Add user message immediately
        addMessageToActiveProfile('user', cleanText, Date.now());

        // Auto-detect boy/girl gender in @tharki mode so Chad flips to Flirty Girl / Flirty Guy
        if (active.mode === 'tharki') {
          detectAndUpdateTharkiGender(cleanText, active);
          updateModeUI();
        }

        // If user is mid-way through inline @friend character creation steps
        if (active.mode === 'friend' && active.friendSetupStep > 0) {
          if (handleInlineFriendSetup(cleanText, active)) {
            chatInput.focus();
            return;
          }
        }

        await generateAndAppendReply(cleanText, active);
      }

      async function generateAndAppendReply(promptText, active) {
        isGenerating = true;
        sendBtn.disabled = true;
        typingIndicator.classList.remove('hidden');
        scrollToBottom();

        try {
          const reply = await fetchGeminiResponse(promptText, active);
          addMessageToActiveProfile('chad', reply, Date.now());
        } finally {
          isGenerating = false;
          sendBtn.disabled = false;
          typingIndicator.classList.add('hidden');
          resetIdleTimer();
          chatInput.focus();
        }
      }

