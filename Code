      // -------------------------------------------------------------------------
      // 3. @NORMAL MODE OFFLINE SMART AI ENGINE
      // -------------------------------------------------------------------------
      function generateOfflineChadReply(input, userName) {
        const q = input.trim();
        const lower = q.toLowerCase();

        if (/^(hi|hello|hey|yo|sup|hola|namaste|good morning|good evening|good afternoon)\b/.test(lower)) {
          const greetings = [
            `Hey ${userName}! Great to hear from you. What are we working on or chatting about today?`,
            `Yo ${userName}! 👋 Chad reporting for duty. Ask me a question, test my coding knowledge, or try **@tharki** / **@friend** modes.`,
            `Hey there, ${userName}! How's your day going? Hit me with whatever's on your mind.`,
          ];
          return greetings[Math.floor(Math.random() * greetings.length)];
        }

        if (lower.includes('who are you') || lower.includes('your name') || lower.includes('what is chad')) {
          return `I'm **Chad.ai**—your personal AI sidekick! No sign-ups, no clutter. Type **@normal** for standard AI help, **@tharki** for spicy rizz 😘🔥, or **@friend** to build your own custom AI bestie 🤝.`;
        }

        if (lower.includes('what time') || lower.includes('current time') || lower.includes('what is the time')) {
          return `Right now it's **${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}** on **${new Date().toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}**.`;
        }

        if (lower.includes('what date') || lower.includes("today's date") || lower.includes('what day is it')) {
          return `Today is **${new Date().toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}**.`;
        }

        const mathMatch = lower.replace(/what is|calculate|solve|\?/g, '').trim();
        if (/^[0-9+\-*/().\s%^]+$/.test(mathMatch) && /[0-9]/.test(mathMatch) && /[+\-*/%^]/.test(mathMatch)) {
          try {
            const sanitized = mathMatch.replace(/\^/g, '**');
            const val = Function(`"use strict"; return (${sanitized})`)();
            if (typeof val === 'number' && isFinite(val)) {
              return `Easy math! **${mathMatch}** equals **${Number(val.toFixed(6))}**.`;
            }
          } catch (_) {}
        }

        if (lower.includes('joke') || lower.includes('make me laugh') || lower.includes('funny')) {
          const jokes = [
            `Why do programmers prefer dark mode?\nBecause light attracts bugs! 🐛`,
            `A SQL query walks into a bar, walks up to two tables, and asks...\n*"Can I join you?"* 😄`,
            `How many programmers does it take to change a light bulb?\nNone—that's a hardware problem!`,
          ];
          return jokes[Math.floor(Math.random() * jokes.length)];
        }

        if (lower.includes('html') || lower.includes('javascript') || lower.includes('python') || lower.includes('code') || lower.includes('program')) {
          return `Here's a clean JavaScript snippet for you, ${userName}:\n\`\`\`javascript\nconst greet = (name) => \`Hello \${name}, welcome to Chad.ai!\`;\nconsole.log(greet("${userName}"));\n\`\`\`\nLet me know what exact problem or language you're working with!`;
        }

        const thoughtfulReplies = [
          `That's an interesting point about **"${q}"**, ${userName}! Breaking it down simply: focus on the core goal first, test your assumptions, and keep things uncomplicated. Want to dive deeper into any specific part?`,
          `Got it, ${userName}! When it comes to **"${q}"**, clarity is everything. Could you share a bit more detail on what you're aiming for so I can give you a super tailored answer?`,
          `Good question, ${userName}! Here's how I look at **"${q}"**: start with the simplest working version first, then refine the details once the foundation is solid.`,
        ];
        return thoughtfulReplies[Math.floor(Math.random() * thoughtfulReplies.length)];
      }

