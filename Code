            m.sender === 'user'
              ? 'text-zinc-200'
              : m.mode === 'tharki'
              ? 'text-rose-400'
              : m.mode === 'friend'
              ? 'text-amber-400'
              : 'text-indigo-400';

          item.innerHTML = `
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="font-mono text-[10px] font-semibold ${badgeColor}">${escapeHtml(senderLabel)}</span>
              <span class="font-mono text-[10px] text-zinc-500">${formatDateLabel(m.timestamp)}</span>
            </div>
            <p class="text-xs text-zinc-400 line-clamp-3 break-words leading-relaxed">${escapeHtml(m.text)}</p>
          `;
          historyList.appendChild(item);
        });
      }

      function renderAll() {
        updateModeUI();
        updateProfileMenuUI();
        renderMessages();
        renderHistorySidebar();
      }

      // =========================================================================
      // MODALS & DROPDOWN CONTROLS
      // =========================================================================
      function toggleProfileDropdown() {
        profileDropdown.classList.toggle('hidden');
      }

      function closeProfileDropdown() {
        profileDropdown.classList.add('hidden');
      }

      function openProfileModal(mode) {
        modalMode = mode;
        closeProfileDropdown();
        profileModalError.classList.add('hidden');

        if (mode === 'edit') {
          const active = getActiveProfile();
          profileModalTitle.textContent = 'Edit Profile Name';
          profileModalLabel.textContent = 'Your Name';
          profileModalInput.value = active ? active.name : '';
        } else {
          profileModalTitle.textContent = 'Add Another Profile';
          profileModalLabel.textContent = 'New Profile Name (Max 2 Profiles)';
          profileModalInput.value = '';
        }

        profileModalOverlay.classList.remove('hidden');
        profileModalOverlay.classList.add('flex');
        setTimeout(() => profileModalInput.focus(), 50);
      }

      function closeProfileModal() {
        profileModalOverlay.classList.add('hidden');
        profileModalOverlay.classList.remove('flex');
      }

      function openConfirmClearModal() {
        closeProfileDropdown();
        const active = getActiveProfile();
        confirmModalText.textContent = `This will permanently delete all saved chat messages for ${active ? active.name : 'this profile'}.`;
        confirmModalOverlay.classList.remove('hidden');
        confirmModalOverlay.classList.add('flex');
      }

      function closeConfirmClearModal() {
        confirmModalOverlay.classList.add('hidden');
        confirmModalOverlay.classList.remove('flex');
      }

      // =========================================================================
      // EVENT LISTENERS
      // =========================================================================
      onboardingForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = onboardingNameInput.value.trim();
        if (!name) {
          onboardingError.classList.remove('hidden');
          return;
        }
        onboardingError.classList.add('hidden');
        createProfile(name);
        onboardingOverlay.classList.add('hidden');
        onboardingOverlay.classList.remove('flex');
        renderAll();
        resetIdleTimer();
        chatInput.focus();
      });

      profilePillBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleProfileDropdown();
      });

      document.addEventListener('click', (e) => {
        if (!profileMenuContainer.contains(e.target)) {
          closeProfileDropdown();
        }
      });

      menuEditNameBtn.addEventListener('click', () => openProfileModal('edit'));
      menuAddProfileBtn.addEventListener('click', () => {
        if (appState.profiles.length < MAX_PROFILES) {
          openProfileModal('add');
        }
      });
      menuSwitchProfileBtn.addEventListener('click', () => {
        const secondary = getSecondaryProfile();
        if (secondary) switchProfile(secondary.id);
      });
      menuClearHistoryBtn.addEventListener('click', openConfirmClearModal);

      profileModalForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = profileModalInput.value.trim();
        if (!val) {
          profileModalError.textContent = 'Name cannot be empty.';
          profileModalError.classList.remove('hidden');
          return;
        }

        if (modalMode === 'edit') {
          renameActiveProfile(val);
          closeProfileModal();
        } else {
          if (appState.profiles.length >= MAX_PROFILES) {
            profileModalError.textContent = 'Maximum of 2 profiles allowed.';
            profileModalError.classList.remove('hidden');
            return;
          }
          createProfile(val);
          closeProfileModal();
          renderAll();
          resetIdleTimer();
        }
      });

      profileModalClose.addEventListener('click', closeProfileModal);
      profileModalCancel.addEventListener('click', closeProfileModal);

      confirmModalCancel.addEventListener('click', closeConfirmClearModal);
      confirmModalOk.addEventListener('click', () => {
        clearActiveProfileHistory();
        closeConfirmClearModal();
      });

      // 18+ @tharki Gate Modal & Persona Toggle Events
      tharkiGateCancel.addEventListener('click', () => {
        pendingTharkiPrompt = null;
        closeTharkiGateModal();
      });

      tharkiGateAgree.addEventListener('click', async () => {
        const active = getActiveProfile();
        if (!active) return;
        active.tharkiConsent = true;
        saveState();
        closeTharkiGateModal();
        switchMode('tharki');
        if (pendingTharkiPrompt) {
          const promptToRun = pendingTharkiPrompt;
          pendingTharkiPrompt = null;
          detectAndUpdateTharkiGender(promptToRun, active);
          await generateAndAppendReply(promptToRun, active);
        }
      });

      tharkiPersonaToggleBtn.addEventListener('click', () => {
        const active = getActiveProfile();
        if (!active) return;
        const order = ['auto', 'girl', 'guy'];
        const nextIdx = (order.indexOf(active.tharkiPersona || 'auto') + 1) % order.length;
        active.tharkiPersona = order[nextIdx];
        saveState();
        updateModeUI();
      });

      // Mode Pills & Friend Character Builder Events
      modePillBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetMode = btn.getAttribute('data-switch-mode');
          const active = getActiveProfile();
          if (active && active.mode !== targetMode) {
            switchMode(targetMode);
          } else if (targetMode === 'friend' && active && !active.friendCharacter) {
            openFriendBuilderModal();
          }
        });
      });

      editFriendCharBtn.addEventListener('click', openFriendBuilderModal);
      friendModalClose.addEventListener('click', closeFriendBuilderModal);
      friendModalCancel.addEventListener('click', closeFriendBuilderModal);

      document.querySelectorAll('.gender-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          friendGenderInput.value = chip.getAttribute('data-gender');
        });
      });

      document.querySelectorAll('.behavior-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          friendBehaviorInput.value = chip.getAttribute('data-behavior');
        });
      });

      friendModalForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const age = parseInt(friendAgeInput.value, 10);
        const gender = friendGenderInput.value.trim();
        const behavior = friendBehaviorInput.value.trim();
        if (isNaN(age) || age < 13 || age > 99 || !gender || !behavior) {
          friendModalError.textContent = 'Please fill in age (13-99), gender, and behavior.';
          friendModalError.classList.remove('hidden');
          return;
        }
        friendModalError.classList.add('hidden');
        saveFriendCharacter(friendNameInput.value, age, gender, behavior);
      });

      // @Command Autocomplete Selection
      cmdOptions.forEach((opt) => {
        opt.addEventListener('click', () => {
          const cmd = opt.getAttribute('data-cmd');
          commandAutocomplete.classList.add('hidden');
          handleSendMessage(cmd);
        });
      });

      autochatToggleBtn.addEventListener('click', () => {
        appState.autoChatEnabled = !appState.autoChatEnabled;
        saveState();
        updateProfileMenuUI();
        if (appState.autoChatEnabled) {
          resetIdleTimer();
        } else if (idleTimer) {
          clearTimeout(idleTimer);
        }
      });

      triggerSelfChatNowBtn.addEventListener('click', () => {
        const active = getActiveProfile();
        if (!active || isGenerating) return;
        const thought = getNextSelfChatThought(active);
        addMessageToActiveProfile('chad-self', thought, Date.now());
        resetIdleTimer();
      });

      toggleHistoryBtn.addEventListener('click', () => {
        historySidebar.classList.toggle('hidden');
        historySidebar.classList.toggle('flex');
        renderHistorySidebar();
      });

      closeHistoryBtn.addEventListener('click', () => {
        historySidebar.classList.add('hidden');
        historySidebar.classList.remove('flex');
      });

      historySearchInput.addEventListener('input', renderHistorySidebar);

      // Chat Input Auto-Resize + @Command Autocomplete Trigger
      chatInput.addEventListener('input', () => {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 144) + 'px';

        const val = chatInput.value.trim().toLowerCase();
        if (val.startsWith('@') && !val.includes(' ')) {
          commandAutocomplete.classList.remove('hidden');
        } else {
          commandAutocomplete.classList.add('hidden');
        }

        resetIdleTimer();
      });

      chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          handleSendMessage(chatInput.value);
        } else if (e.key === 'Escape') {
          commandAutocomplete.classList.add('hidden');
        }
      });

      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        handleSendMessage(chatInput.value);
      });

      window.addEventListener('beforeunload', () => {
        appState.lastClosedAt = Date.now();
        saveState();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          appState.lastClosedAt = Date.now();
          saveState();
        }
      });

      // =========================================================================
      // INITIALIZATION
      // =========================================================================
      function init() {
        loadState();

        if (appState.profiles.length === 0) {
          onboardingOverlay.classList.remove('hidden');
          onboardingOverlay.classList.add('flex');
          setTimeout(() => onboardingNameInput.focus(), 60);
        } else {
          handleMessagesWhileClosed();
          renderAll();
          resetIdleTimer();
        }
      }

      init();
    })();
  </script>
</body>
  </html>
