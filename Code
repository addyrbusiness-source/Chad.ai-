      // Header & Mode UI Elements
      const brandLogoBox = document.getElementById('brand-logo-box');
      const activeModeBadge = document.getElementById('active-mode-badge');
      const headerSubtitle = document.getElementById('header-subtitle');
      const modePillBtns = document.querySelectorAll('.mode-pill-btn');
      const commandAutocomplete = document.getElementById('command-autocomplete');
      const cmdOptions = document.querySelectorAll('.cmd-option');

      const headerAvatar = document.getElementById('header-avatar');
      const headerProfileName = document.getElementById('header-profile-name');
      const profilePillBtn = document.getElementById('profile-pill-btn');
      const profileDropdown = document.getElementById('profile-dropdown');
      const profileMenuContainer = document.getElementById('profile-menu-container');

      const dropdownActiveName = document.getElementById('dropdown-active-name');
      const dropdownMsgCount = document.getElementById('dropdown-msg-count');
      const menuEditNameBtn = document.getElementById('menu-edit-name-btn');
      const switchProfileSection = document.getElementById('switch-profile-section');
